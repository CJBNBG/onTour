<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ==== Berechtigungen (siehe README Abschnitt 2) ==== -->
    <!-- Laden der Kartenkacheln (OpenStreetMap/OpenSeaMap). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Standort für Tacho, Track und Satellitenanzahl. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Für den Foreground-Service während einer Track-Aufzeichnung
         (siehe Abschnitt 19). FOREGROUND_SERVICE seit Android 9 für jeden
         Foreground-Service nötig, FOREGROUND_SERVICE_LOCATION zusätzlich
         ab Android 14 (API 34) für einen Foreground-Service vom Typ
         "location" - geolocator startet einen solchen automatisch, sobald
         ein ForegroundNotificationConfig übergeben wird (siehe
         TrackRecordingService._startListening). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Ab Android 13 (API 33) für JEDE Benachrichtigung nötig - sowohl
         für die dauerhafte Aufzeichnungs-Benachrichtigung (Abschnitt 19)
         als auch für die Pause-Erinnerung (Abschnitt 22). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Für enableWakeLock: true in der Foreground-Service-Konfiguration
         (Abschnitt 19) zwingend nötig, sonst SecurityException beim Start
         der Aufzeichnung. Normale ("ungefährliche") Berechtigung - wird
         automatisch bei der Installation gewährt, keine Laufzeit-Abfrage
         nötig. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- NEU (Abschnitt 72): Schrittzähler. ACTIVITY_RECOGNITION ist ab
         Android 10 eine Laufzeit-Berechtigung (Abfrage per permission_handler
         erst auf Wunsch des Nutzers). RECEIVE_BOOT_COMPLETED: plant den
         Mitternachts-Alarm nach einem Neustart neu (normale Berechtigung). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- ==== Anwendung ====
         android:name=".OnTourApplication" - NEU (Abschnitt 21): eigene
         Application-Klasse, die schon beim Start des Android-Prozesses
         eine app-weite, dauerhafte FlutterEngine erzeugt - Grundlage
         dafür, dass eine laufende Track-Aufzeichnung ein Wischen aus den
         zuletzt verwendeten Apps übersteht. -->
    <application
        android:label="onTour"
        android:name=".OnTourApplication"
        android:icon="@mipmap/launcher_icon">
        <!-- android:launchMode="singleTask" - NEU (Abschnitt 23): sorgt
             dafür, dass ein Antippen der Pause-Erinnerung bei bereits
             existierender Activity zuverlässig onNewIntent auf der
             VORHANDENEN Instanz auslöst statt eine zweite, parallele
             Instanz zu erzeugen (die sich sonst die persistente
             FlutterEngine aus Abschnitt 21 streitig machen würde).

             android:screenOrientation="portrait" - NEU (Abschnitt 21):
             robuster, von der Activity-/Engine-Start-Reihenfolge
             unabhängiger Ersatz für den Dart-seitigen
             SystemChrome.setPreferredOrientations(...)-Aufruf in
             main.dart, der durch die persistente Engine jetzt schon vor
             der ersten Activity läuft und deshalb u. U. wirkungslos
             bleiben könnte. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- NEU (Abschnitt 22): Empfänger für den nativ geplanten
             Erinnerungs-Alarm bei anhaltend pausierter Track-
             Aufzeichnung. exported="false", da er ausschließlich vom
             eigenen, intern gesetzten AlarmManager-Alarm ausgelöst werden
             soll, nicht von anderen Apps. -->
        <receiver
            android:name=".AutoPauseReminderReceiver"
            android:exported="false" />
        <!-- NEU (Abschnitt 72): Mitternachts-Snapshot des Schrittzählers. -->
        <receiver
            android:name=".StepMidnightReceiver"
            android:exported="false" />
        <receiver
            android:name=".StepBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- NEU (Abschnitt 45): url_launcher benoetigt ab Android 11 diese
             Paketsichtbarkeit, um https-Links extern (Play Store) zu
             oeffnen. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
